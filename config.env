# Loan Origination System settings, read by every script (shell and Python).
# To change one, put it in config.local.env (git-ignored); that file is read after this one.

EXASOL_DEPLOYMENT=default        # Exasol Personal deployment (~/.exasol/personal/deployments/<name>)
EXAPUMP_PROFILE=starter-kit      # admin profile in ~/.exapump/config.toml, used only by the setup scripts
SRC_HOST=10.88.0.1               # address the database uses to reach the source containers (podman gateway in the VM)

PG_PORT=55444                    # core banking, Postgres 16 (container los-core-pg)
MONGO_PORT=37028                 # document store, MongoDB 8.2 (container los-docs-mongo)
BUREAU_PORT=8591                 # credit report API, mocked (container los-bureau-api)

LOS_PORT=8527                    # LOS service, loopback only
DASH_SERVER_PORT=5100            # dash-server (Exasol starter kit add-on)
DASH_APP=loan-origination        # console URL: http://127.0.0.1:<DASH_SERVER_PORT>/apps/<DASH_APP>/

TEXTRACT=on                      # on: read uploads with Amazon Textract, which AWS bills per page (see README: Cost).
                                 # off: never call AWS; uploads are read from the PDF text layer and the page says so.
TEXTRACT_PROFILE=                # AWS profile for Amazon Textract; empty = the default AWS credential chain.
TEXTRACT_REGION=ap-south-1       # Without AWS credentials uploads are read from the PDF text layer and the page says so.
TIME_ZONE=Asia/Kolkata           # decision-log times
APP_DATE=2026-10-27              # date stamped on live uploads: the synthetic bank data runs to 24 Oct 2026, and an
                                 # application looks at the six full months before its month. Keep it inside the data.
